#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

VENV=.venv
if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv "$VENV"
fi

if ! "$VENV/bin/python" -c 'import pymysql' >/dev/null 2>&1; then
    "$VENV/bin/pip" install pymysql
fi
if ! "$VENV/bin/python" -c 'import pytest' >/dev/null 2>&1; then
    "$VENV/bin/pip" install pytest
fi

"$VENV/bin/python" -m pytest tests -q
echo "planner ready: $PWD/$VENV/bin/python -m logistics_planner"
